# ---------------------------------------------------------------------------
# GoHighLevel (T1.2 / T1.3)
# ---------------------------------------------------------------------------
# Private Integration Token from Settings > Private Integrations.
# NOT an OAuth marketplace app — PIT is a static token, same rate limits,
# no refresh flow. Scope it to the demo sub-account only.
GHL_PIT=

# Sub-account (location) id. Settings > Business Profile, or the URL:
# app.gohighlevel.com/v2/location/<THIS>/dashboard
GHL_LOCATION_ID=

# One calendar per bookable resource, named GHL_CALENDAR_<RESOURCE_ID>.
# The hotel books rooms and restaurant tables separately.
GHL_CALENDAR_ROOM=
GHL_CALENDAR_TABLE=

# Fallback for single-resource verticals (roofing has only "inspection").
GHL_CALENDAR_ID=

# Pipeline the agent drops opportunities into.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_NEW=

# Pinned explicitly — never rely on a server default. Every slot lookup and
# booking passes this. Getting it wrong puts every appointment off by hours.
GHL_TIMEZONE=America/Chicago

# API version header GHL requires on every v2 request. Do not change casually.
GHL_API_VERSION=2021-07-28

# ---------------------------------------------------------------------------
# Webhook probe (T1.4)
# ---------------------------------------------------------------------------
WEBHOOK_PORT=4000

# ---------------------------------------------------------------------------
# Filled in later this week
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Speech recognition tuning
# ---------------------------------------------------------------------------
# Accent handling. "en" is tuned for American English and does measurably worse
# on other accents. nova-3 accepts regional variants and per-segment detection:
#   en      American English (default)
#   en-IN   Indian English      en-GB  British      en-AU  Australian
#   multi   detect the language per segment of speech
# Set this to match the callers a client actually gets.
LK_STT_LANGUAGE=en

# Override the STT model if needed. deepgram/nova-2-phonecall is tuned for
# telephone-quality audio, which matters once we are on real phone lines.
# LK_STT_MODEL=deepgram/nova-3

# ---------------------------------------------------------------------------
# Admin dashboard (apps/web /admin)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# openssl rand -hex 32   (unset = random per restart, logging everyone out)
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Admin console roles
# ---------------------------------------------------------------------------
# Optional read-only account. A viewer sees everything EXCEPT customer content:
# emails and phone numbers are masked, transcripts / email bodies / raw webhook
# payloads are refused, and every write is blocked. Leave blank for no viewer.
VIEWER_EMAIL=
VIEWER_PASSWORD=

# ---------------------------------------------------------------------------
# Automation (runs inside the web server — no second command)
# ---------------------------------------------------------------------------
# AUTOMATION=off          switch every background job off
# AUTOMATION_WRITE=off    run the jobs as a dry run (log only, change nothing)
# SOCIAL_AUTOPOST=off     stop automatic social scheduling (posts are scheduled,
#                         never published on the spot, so they can be cancelled)
# SCHED_ABANDONED_MIN=5   how often the abandoned-chat sweep runs
# SCHED_SOCIAL_POST_HOURS=24
#
# Social posts go to EVERY connected account (one post per account). To restrict
# them, list account names or ids, comma-separated, e.g.:
# SOCIAL_ACCOUNTS=Fashion icons,l_a_a_j_
#
# Email: dry_run writes and stores follow-ups but never sends. "on" sends for
# real; set LEAD_AUTOSEND_ALLOWLIST (comma-separated emails or domains) to limit
# who can receive mail until your sending domain is verified.
# LEAD_AUTOSEND=dry_run
# LEAD_AUTOSEND_ALLOWLIST=you@yourdomain.com

# ---------------------------------------------------------------------------
# GHL workflow webhook (/webhooks/ghl) — social DMs, forms, Facebook lead forms
# ---------------------------------------------------------------------------
# The workflow's Custom Webhook action sends this as the `x-webhook-secret`
# header. Unset = the endpoint accepts anything, which is fine on localhost and
# NOT fine on a public URL (each accepted lead writes to the CRM).
# openssl rand -hex 24
GHL_WEBHOOK_SECRET=

# Facebook + Instagram DMs are pulled from GHL's Conversations API into our
# database and turned into leads (no webhook, no premium workflow action).
# SOCIAL_DM_SYNC=off      stop the DM poll
# SCHED_DM_MIN=2          how often it checks, in minutes
